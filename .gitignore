/livewire
/livewire.exe
*.exe
*.test
*.out

# captures / caches
*.pcap
*.pcapng
*.cache
__pycache__/
*.pyc
!testdata/**

# local test and verification output
coverage/
.coverage/
dist-verify*/

# editor / OS
.vscode/
.idea/
.DS_Store

# AI/agent scratch docs and workspaces
AGENTS.md
CLAUDE.md
INSTALL.md
QUICKSTART.md
.claude/
.agents/
.codex/

# internal reference, not distributed (documented in docs/DOCUMENTATION.md instead)
REPRODUCE.md

# release artifacts: binaries and packaged documents are published on the GitHub
# Releases page and are never committed. Each tagged version keeps only its
# checksum manifest and SBOM here, so CI can prove a rebuilt release is
# byte-identical to what was published and the repository stays small enough to
# clone. Order matters: a directory must be re-included before its contents.
dist/*
!dist/v*/
dist/v*/*
!dist/v*/SHA256SUMS
!dist/v*/*.cdx.json
